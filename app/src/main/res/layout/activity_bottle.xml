<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/ochakovo_gray" android:padding="16dp" android:gravity="center">

    <!-- Квасенок -->
    <androidx.cardview.widget.CardView
        android:layout_width="120dp" android:layout_height="120dp"
        app:cardCornerRadius="60dp" app:cardElevation="8dp" android:layout_marginBottom="16dp">
        <ImageView
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/kvasenok" android:scaleType="centerCrop"/>
    </androidx.cardview.widget.CardView>

    <!-- Текст запроса Квасенка (Именно этот ID не находил компилятор) -->
    <TextView
        android:id="@+id/tvRequest"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Квасенок: Хочу что-то освежающее!"
        android:textSize="20sp" android:textStyle="bold" android:textColor="@color/ochakovo_dark"
        android:background="@drawable/bg_dialog" android:padding="16dp" android:layout_marginBottom="32dp"
        android:gravity="center"/>

    <!-- Картинки с напитками -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center" android:weightSum="3">

        <ImageView
            android:id="@+id/imgMojito"
            android:layout_width="0dp" android:layout_height="120dp" android:layout_weight="1"
            android:src="@drawable/mojito" android:scaleType="fitCenter" android:layout_margin="8dp"/>

        <ImageView
            android:id="@+id/imgKvas"
            android:layout_width="0dp" android:layout_height="120dp" android:layout_weight="1"
            android:src="@drawable/kvas" android:scaleType="fitCenter" android:layout_margin="8dp"/>

        <ImageView
            android:id="@+id/imgPivo"
            android:layout_width="0dp" android:layout_height="120dp" android:layout_weight="1"
            android:src="@drawable/pivo" android:scaleType="fitCenter" android:layout_margin="8dp"/>

    </LinearLayout>

    <!-- Текст результата (появится после клика) -->
    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textSize="18sp" android:textColor="@color/ochakovo_dark"
        android:background="@drawable/bg_dialog" android:padding="16dp" android:layout_marginTop="24dp"
        android:visibility="gone"/>
</LinearLayout>