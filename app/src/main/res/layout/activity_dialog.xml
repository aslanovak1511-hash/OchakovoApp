<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/ochakovo_gray">

    <!-- Персонаж (Крупная картинка на фоне) -->
    <ImageView
        android:id="@+id/imgCharacter"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/kvasenok"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/dialogBox"/>

    <!-- Блок диалога (внизу экрана) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/dialogBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_margin="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@color/white">

            <!-- Имя персонажа -->
            <TextView
                android:id="@+id/tvCharacterName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Квасенок"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/ochakovo_red"
                android:layout_marginBottom="8dp"/>

            <!-- Текст реплики (сюда печатается текст) -->
            <TextView
                android:id="@+id/tvDialogText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Текст..."
                android:textSize="18sp"
                android:textColor="@color/ochakovo_dark"
                android:minHeight="80dp"/>

            <!-- Кнопка Далее -->
            <Button
                android:id="@+id/btnNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Далее ▶"
                android:layout_gravity="end"
                android:backgroundTint="@color/ochakovo_red"
                android:textColor="@color/white"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>